{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "sender_device_id": {
      "type": "string",
      "title": "Sender Device ID"
    },
    "sender_name": {
      "type": "string",
      "title": "Sender Name"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "chat_type": {
      "type": "string",
      "title": "Chat Type",
      "enum": [
        "common",
        "personal",
        "group"
      ],
      "default": "common"
    },
    "room_id": {
      "type": "string",
      "title": "Room ID"
    },
    "recipient_device_id": {
      "type": "string",
      "title": "Recipient Device ID",
      "default": ""
    },
    "recipient_name": {
      "type": "string",
      "title": "Recipient Name",
      "default": ""
    }
  },
  "required": [
    "sender_device_id",
    "sender_name",
    "content",
    "chat_type",
    "room_id"
  ]
}