{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "title": "Device ID"
    },
    "rating": {
      "type": "number",
      "title": "Rating (1-5)",
      "minimum": 1,
      "maximum": 5,
      "default": 5
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "suggestion",
        "bug",
        "appreciation",
        "other"
      ],
      "default": "suggestion"
    },
    "message": {
      "type": "string",
      "title": "Feedback Message"
    }
  },
  "required": [
    "device_id",
    "rating",
    "message"
  ]
}