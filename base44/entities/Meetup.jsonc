{
  "name": "Meetup",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title",
      "default": "Online Meetup"
    },
    "meet_url": {
      "type": "string",
      "title": "Google Meet URL",
      "format": "uri"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "title": "End Time"
    },
    "status_override": {
      "type": "string",
      "title": "Status Override",
      "enum": [
        "auto",
        "upcoming",
        "live",
        "completed"
      ],
      "default": "auto"
    }
  },
  "required": [
    "meet_url",
    "start_time",
    "end_time"
  ]
}