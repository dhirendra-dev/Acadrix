{
  "name": "ResourceLink",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Resource Title"
    },
    "url": {
      "type": "string",
      "title": "Google Drive Link",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "default": ""
    },
    "resource_type": {
      "type": "string",
      "title": "Resource Type",
      "enum": [
        "notes",
        "pyq",
        "dpp",
        "video",
        "book",
        "other"
      ],
      "default": "notes"
    },
    "folder_id": {
      "type": "string",
      "title": "Folder ID",
      "default": ""
    },
    "pinned": {
      "type": "boolean",
      "title": "Pinned to Home",
      "default": false
    },
    "high_demand": {
      "type": "boolean",
      "title": "High Demanded by Students",
      "default": false
    },
    "is_rj_sir": {
      "type": "boolean",
      "title": "RJ Sir PDF",
      "default": false
    }
  },
  "required": [
    "title",
    "url"
  ]
}